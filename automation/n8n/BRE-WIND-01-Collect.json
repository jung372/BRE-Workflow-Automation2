{
  "name": "BRE-WIND-01-Collect",
  "active": false,
  "nodes": [
    {
      "id": "a6c3e1df-1e6d-5b35-8e8d-eeb86b2524bc",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 * * * *"
            },
            {
              "field": "cronExpression",
              "expression": "30 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c637d191-85b3-5a45-936d-7b55d63cfe4d",
      "name": "Manual test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ],
      "parameters": {}
    },
    {
      "id": "2af05afd-a3ac-5e88-a580-f33105887dec",
      "name": "Configure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const issue_date = $now.setZone('Asia/Seoul').toFormat('yyyy-MM-dd');\nreturn [{json: {service_url: \"http://news-service:8090\", issue_date, issue_id: 'wind-' + issue_date, deadline: Date.now() + 1100000}}}];"
      }
    },
    {
      "id": "981d0f0e-cd1c-5d56-83db-d54b965b41bc",
      "name": "Submit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configure').first().json.service_url + '/v1/collect' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 35000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $workflow.name + ':' + $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({issue_date: $('Configure').first().json.issue_date}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BRE Wind Service"
        }
      }
    },
    {
      "id": "65ef8c29-fc7c-5b9e-89a8-f54db8b278e8",
      "name": "Wait for job",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "10501333-93da-5479-a4bd-9143cb1c5757",
      "name": "Poll job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1280,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configure').first().json.service_url + '/v1/jobs/' + $('Submit').first().json.job_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 35000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "BRE Wind Service"
        }
      }
    },
    {
      "id": "833607bb-81b0-52ec-914f-2b0decfdb50f",
      "name": "Check outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        0
      ],
      "parameters": {
        "jsCode": "if ($json.status === 'FAILED') throw new Error('news_job_failed:' + ($json.error_code || 'unknown'));\nif (!['QUEUED','RUNNING','SUCCEEDED'].includes($json.status)) throw new Error('invalid_job_status');\nif (Date.now() > $('Configure').first().json.deadline) throw new Error('news_job_deadline');\nreturn $input.all();"
      }
    },
    {
      "id": "3ffea801-cf34-54e3-ba7a-ddb573f5a53f",
      "name": "Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1700,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "job-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "SUCCEEDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "af34e3ee-1e82-5fb9-85d1-654336c64d5e",
      "name": "Setup instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        160,
        -300
      ],
      "parameters": {
        "content": "## Import inactive\nBind every HTTP node to Header Auth `BRE Wind Service`: Authorization = Bearer <service token>. Edit Configure.service_url. No credentials are included. Shadow review is the default. Set Error workflow to imported BRE-WIND-05A-Errors. Read docs/wind-news-operations.md before enabling schedules.",
        "height": 240,
        "width": 600
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual test": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Submit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit": {
      "main": [
        [
          {
            "node": "Wait for job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for job": {
      "main": [
        [
          {
            "node": "Poll job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll job": {
      "main": [
        [
          {
            "node": "Check outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check outcome": {
      "main": [
        [
          {
            "node": "Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Completed?": {
      "main": [
        [],
        [
          {
            "node": "Wait for job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Seoul",
    "executionTimeout": 1200,
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false
  },
  "pinData": {},
  "tags": []
}
