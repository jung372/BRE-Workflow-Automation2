{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bre:wind-news:issue:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_id", "issue_date", "revision", "timezone", "window_start", "window_end", "published_at", "content_status", "coverage", "counts", "headline_summary", "items"],
  "properties": {
    "schema_version": {"const": 1}, "issue_id": {"type": "string", "pattern": "^wind-[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "issue_date": {"type": "string", "format": "date"}, "revision": {"type": "integer", "minimum": 1},
    "timezone": {"const": "Asia/Seoul"}, "window_start": {"type": "string", "format": "date-time"},
    "window_end": {"type": "string", "format": "date-time"}, "published_at": {"type": "string", "format": "date-time"},
    "content_status": {"enum": ["normal", "partial", "no_news"]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["expected_sources", "successful_sources", "partial"], "properties": {"expected_sources": {"type": "integer", "minimum": 1}, "successful_sources": {"type": "integer", "minimum": 1}, "partial": {"type": "boolean"}}},
    "counts": {"$ref": "#/$defs/counts"},
    "headline_summary": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
    "items": {"type": "array", "maxItems": 15, "items": {"$ref": "#/$defs/item"}},
    "correction_reason": {"type": "string", "minLength": 1}, "corrected_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "counts": {"type": "object", "additionalProperties": false, "required": ["fetched", "eligible_articles", "merged_duplicates", "published_topics", "held"], "properties": {"fetched": {"type": "integer", "minimum": 0}, "eligible_articles": {"type": "integer", "minimum": 0}, "merged_duplicates": {"type": "integer", "minimum": 0}, "published_topics": {"type": "integer", "minimum": 0, "maximum": 15}, "held": {"type": "integer", "minimum": 0}, "deferred": {"type": "integer", "minimum": 0}}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "representative_article_id", "headline", "summary", "primary_category", "contract_stage", "companies", "project_name", "region", "wind_type", "tags", "source_name", "source_url", "source_published_at", "timestamp_basis", "evidence_scope", "late_arrival"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "representative_article_id": {"type": "string", "minLength": 1},
        "headline": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "summary": {"type": "string", "minLength": 1},
        "primary_category": {"enum": ["EPC·시공", "금융·PF", "터빈·공급계약", "인허가·정책", "사고·안전", "민원·수용성", "MOU·협약", "착공·준공·상업운전", "산업·공급망", "기타 주요 동향"]},
        "contract_stage": {"enum": ["검토", "우선협상", "MOU", "본계약", "조건부 계약", "금융약정", "금융종결", "실행", "해지·변경", "미확인"]},
        "wind_type": {"enum": ["육상", "고정식 해상", "부유식 해상", "공통", "미확인"]},
        "companies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "project_name": {"type": ["string", "null"]}, "region": {"type": ["string", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}}, "source_name": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "pattern": "^https://", "format": "uri"},
        "source_published_at": {"type": "string", "format": "date-time"}, "timestamp_basis": {"type": "string"},
        "evidence_scope": {"enum": ["full_text", "description", "title"]}, "late_arrival": {"type": "boolean"},
        "amount": {"type": ["number", "null"]}, "currency": {"type": ["string", "null"]},
        "capacity": {"type": ["number", "null"]}, "capacity_unit": {"type": ["string", "null"]}, "event_date": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
